mod seed-readme

;; The README of a published seed, read from its tarball.
;;
;; `irij publish` bundles the project's README.md (or README) into the
;; .tar.gz it uploads, but sends no README in its metadata — so the
;; registry reads it from the tarball, which works for every CLI
;; release, and backfills older versions from their stored tarballs.
;;
;; The archive is walked one 512-byte tar header at a time: file
;; bodies are skipped, never read, so a large or hostile tarball costs
;; no memory. Only a README at the archive's root counts; README.md
;; wins over README. macOS tar's AppleDouble entries (`._README.md`)
;; are other names and are passed over.
;;
;; The same walk finds the seed's irij.toml (tarball-toml), which
;; seed-deps.irj reads the seed's own [seeds] from.

;; What is stored and served: a longer README is cut here.
pub max-readme-bytes := 262144

;; Headers walked before giving up — far more files than any seed has.
max-entries := 10000

;; "README.md" → 2, "README" → 1, anything else → 0. A leading "./"
;; is dropped; case doesn't matter.
pub fn readme-rank :: Str Int
  => raw-name
  name := lower-case (root-name raw-name)
  cond
    name == "readme.md" => 2
    name == "readme" => 1
    _ => 0

;; "irij.toml" at the root → 1, anything else → 0. Case matters, as it
;; does to the CLI.
pub fn toml-rank :: Str Int
  (raw-name -> if (root-name raw-name == "irij.toml") 1 else 0)

fn root-name :: Str Str
  (raw-name -> if (starts-with? raw-name "./") (substring raw-name 2 (length raw-name)) else raw-name)

;; A tar header field: the text up to its first NUL.
fn field :: Str Int Int Str
  => header from len
  raw := substring header from (from + len)
  cut := index-of raw (from-char-code 0)
  if (cut < 0) raw else (substring raw 0 cut)

;; A tar size field is octal digits, space- or NUL-padded. -1 when it
;; isn't (base-256 sizes past 8 GiB, garbage).
fn octal :: Str Int
  => s
  digits := trim s
  if (digits == "")
    0
  else
    octal-from digits 0 0

fn octal-from :: Str Int Int Int
  => s i acc
  if (i >= length s)
    acc
  else
    d := char-code (substring s i (i + 1)) - 48
    if (d < 0 || d > 7)
      -1
    else
      octal-from s (i + 1) (acc * 8 + d)

fn padded :: Int Int
  (size -> ((size + 511) / 512) * 512)

;; The body of the current entry, decoded as UTF-8, at most
;; max-readme-bytes of it; the stream is left at the next header.
fn read-body :: _ Int Str ::: JVM
  => gz size
  keep := min size max-readme-bytes
  bytes := gz#readNBytes keep
  gz#skipNBytes (padded size - keep)
  text := java.lang.String/new bytes "UTF-8"
  if (size > keep) (text ++ "\n\n…") else text

;; Walk the headers; `best` is #(rank text) of the best-ranked entry so
;; far (rank-of: readme-rank or toml-rank).
fn walk :: _ _ Int Tuple Str ::: JVM
  => rank-of gz n best
  header-bytes := gz#readNBytes 512
  #(best-rank best-text) := best
  if (n >= max-entries || length header-bytes < 512)
    best-text
  else
    header := java.lang.String/new header-bytes "ISO-8859-1"
    name := field header 0 100
    size := octal (field header 124 12)
    kind := substring header 156 157
    regular := kind == "0" || kind == (from-char-code 0)
    rank := rank-of name
    cond
      name == "" || size < 0 => best-text
      regular && rank > best-rank =>
        walk rank-of gz (n + 1) #(rank (read-body gz size))
      _ =>
        gz#skipNBytes (padded size)
        walk rank-of gz (n + 1) best

;; The README in the .tar.gz at `path`, or "" when it has none or the
;; file isn't a readable tar.gz.
pub fn tarball-readme :: Str Str ::: JVM
  (path -> tarball-entry readme-rank path)

;; The irij.toml in the .tar.gz at `path`, or "" (as tarball-readme).
pub fn tarball-toml :: Str Str ::: JVM
  (path -> tarball-entry toml-rank path)

;; The names of the regular files in the .tar.gz at `path` (a leading
;; "./" dropped), at most max-entries of them; #[] when it isn't a
;; readable tar.gz. No body is read.
pub fn tarball-names :: Str Vector ::: JVM
  => path
  outcome := try (-> open-and-list path)
  match outcome
    Ok names => names
    Err _ => #[]

fn open-and-list :: Str Vector ::: JVM
  => path
  file := java.io.FileInputStream/new path
  outcome := try (-> gunzip-list file)
  file#close ()
  match outcome
    Ok names => names
    Err e => error e

fn gunzip-list :: _ Vector ::: JVM
  => file
  gz := java.util.zip.GZIPInputStream/new file
  outcome := try (-> list-names gz 0 #[])
  gz#close ()
  match outcome
    Ok names => names
    Err e => error e

fn list-names :: _ Int Vector Vector ::: JVM
  => gz n acc
  header-bytes := gz#readNBytes 512
  if (n >= max-entries || length header-bytes < 512)
    acc
  else
    header := java.lang.String/new header-bytes "ISO-8859-1"
    name := field header 0 100
    size := octal (field header 124 12)
    kind := substring header 156 157
    regular := kind == "0" || kind == (from-char-code 0)
    if (name == "" || size < 0)
      acc
    else
      gz#skipNBytes (padded size)
      list-names gz (n + 1) (if regular (conj acc (root-name name)) else acc)

fn tarball-entry :: _ Str Str ::: JVM
  => rank-of path
  outcome := try (-> open-and-walk rank-of path)
  match outcome
    Ok text => text
    Err _ => ""

fn open-and-walk :: _ Str Str ::: JVM
  => rank-of path
  file := java.io.FileInputStream/new path
  outcome := try (-> gunzip-walk rank-of file)
  file#close ()
  match outcome
    Ok text => text
    Err e => error e

fn gunzip-walk :: _ _ Str ::: JVM
  => rank-of file
  gz := java.util.zip.GZIPInputStream/new file
  outcome := try (-> walk rank-of gz 0 #(0 ""))
  gz#close ()
  match outcome
    Ok text => text
    Err e => error e
