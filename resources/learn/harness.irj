;; Exercise harness for the /learn course.
;;
;; resources/learn.js appends this file, then an exercise's `check`
;; block, to the learner's code and evaluates the whole program in the
;; playground sandbox (POST /eval). scripts/check-course.irj does the
;; same with each exercise's solution. Each `course-check` prints one
;; line the page turns into a ✓ or ✗:
;;
;;   @@pass <label>
;;   @@fail <label>@@<expected>@@<got>
;;
;; The thunk runs under `try`, so one failing check doesn't stop the
;; ones after it. Names start with `course-` to stay clear of the
;; learner's own.

;; Expected and got are shown the way source writes them — every Str in
;; quotes, at any depth — so `#["tea: 3"]` and `#["tea:" 3]` can't print
;; alike. (`to-str` drops the quotes inside a collection.)
fn course-show
  => v
  match (type-of v)
    "Str" => course-quote v
    "Vector" => "#[" ++ course-show-all v ++ "]"
    "Tuple" => "#(" ++ course-show-all (to-vec v) ++ ")"
    "Set" => "#{" ++ course-show-all (to-vec v) ++ "}"
    "Map" => "{" ++ join " " (keys v |> @ (k -> course-key k ++ "= " ++ course-show-in (get k v))) ++ "}"
    "Ok" => "Ok " ++ course-show-in (course-field v)
    "Err" => "Err " ++ course-show-in (course-field v)
    _ => to-str v

fn course-show-all
  (xs -> join " " (xs |> @ course-show-in))

;; A variant with a field nests in parentheses: #[(Ok 1) (Err "e")].
fn course-show-in
  => v
  t := type-of v
  if (t == "Ok" || t == "Err")
    "(" ++ course-show v ++ ")"
  else
    course-show v

fn course-field
  (Ok x) => x
  (Err x) => x

fn course-quote
  => s
  esc := replace (replace (replace (replace s "\\" "\\\\") "\"" "\\\"") "\n" "\\n") "\t" "\\t"
  "\"" ++ esc ++ "\""

;; A key that is no field name (`Content-Type`, `a b`) is quoted.
fn course-key
  => k
  plain := split k "" |> /? (c -> ! (contains? (split "abcdefghijklmnopqrstuvwxyz0123456789-_?!:" "") c))
  if (empty? plain && k /= "") k else (course-quote k)

fn course-check ::: Console
  => label thunk want
  r := try thunk
  match r
    Ok got =>
      if (got == want)
        println ("@@pass " ++ label)
      else
        println ("@@fail " ++ label ++ "@@" ++ course-show want ++ "@@" ++ course-show got)
    Err e =>
      println ("@@fail " ++ label ++ "@@" ++ course-show want ++ "@@error: " ++ to-str e)
